# ═══════════════════════════════════════════════════════════
# claude-ai-OS Docker Configuration
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════════

# Auth — credentials are auto-mounted from ~/.claude/.credentials.json
# Run 'claude login' on your host once. Token refreshes automatically.
# For CI/CD without a host credentials file, uncomment:
# CLAUDE_SESSION_TOKEN=sk-ant-oat01-your-token-here

# Required — GitHub repo to clone into the workspace
GITHUB_REPO=https://github.com/your-org/your-project.git
GITHUB_BRANCH=main

# Optional — GitHub token for private repos
GITHUB_TOKEN=

# Project name (used in pipeline state and reports)
PROJECT_NAME=my-project

# Ports
DASHBOARD_PORT=8080      # Orchestrator API + pipeline dashboard
REPORT_PORT=8081         # Static file server for HTML reports

# Smoke test target (where the running app is)
# Use host.docker.internal to reach services on the Docker host
SMOKE_TEST_URL=http://host.docker.internal:5173
